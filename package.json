{
  "name": "book2film-studio", "version": "0.1.0", "private": true, "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "preview": "wrangler dev --port 8797",
    "db:local": "wrangler d1 migrations apply DB --local",
    "package:worker": "wrangler deploy --dry-run --outdir .test-build",
    "test": "npm run build && npm run package:worker && node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": { "react": "19.2.8", "react-dom": "19.2.8", "@fontsource/space-grotesk": "5.3.0", "@fontsource/ibm-plex-mono": "5.3.0" },
  "devDependencies": { "vite": "8.2.2", "@vitejs/plugin-react": "6.1.1", "tailwindcss": "4.3.3", "@tailwindcss/vite": "4.3.3", "wrangler": "4.129.0", "miniflare": "5.20260820.0-alpha", "@playwright/test": "1.63.0" }
}
